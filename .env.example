# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed. This template IS committed.
# docker compose automatically reads `.env` for ${VAR} substitution.

# ─────────────── OANDA ───────────────
# 'practice' => api-fxpractice.oanda.com  |  'live' => api-fxtrade.oanda.com
OANDA_ENV=practice
OANDA_API_KEY=replace_me_with_your_practice_token
OANDA_ACCOUNT_ID=101-004-xxxxxxxx-001

# ─────────── PostgreSQL / TimescaleDB ───────────
POSTGRES_USER=oft
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=oft
POSTGRES_PORT=5442
# Used by the Python services to connect (note the non-default host port).
DATABASE_URL=postgresql://oft:change_me_locally@localhost:5442/oft

# ─────────────── Redis ───────────────
REDIS_PORT=6389
REDIS_URL=redis://localhost:6389/0
